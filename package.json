{
  "name": "nesto-qa-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation suite for the nesto Signup page",
  "scripts": {
    "test": "playwright test -c config/playwright.config.ts",
    "test:en": "playwright test -c config/playwright.config.ts --project=chromium-en",
    "test:fr": "playwright test -c config/playwright.config.ts --project=chromium-fr",
    "test:smoke": "playwright test -c config/playwright.config.ts --project=api --project=chromium-en --project=chromium-fr --grep @smoke --grep-invert @known-bug",
    "test:smoke:known": "playwright test -c config/playwright.config.ts --project=api --project=chromium-en --project=chromium-fr --grep \"(?=.*@smoke)(?=.*@known-bug)\"",
    "test:regression": "playwright test -c config/playwright.config.ts --grep-invert @known-bug",
    "test:known": "playwright test -c config/playwright.config.ts --grep @known-bug",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "typescript": "^7.0.2"
  }
}
